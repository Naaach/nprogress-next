---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entries = await getCollection('docs');
const sorted = entries.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const pb = '<ProgressBar />';
---

<Layout title="nprogress-next" description="A modern, dependency-free, multi-framework drop-in replacement for NProgress.">
  <style>
    .hero-header {
      padding: 4rem 1.5rem;
      text-align: center;
      background: linear-gradient(180deg, var(--bg-elevated) 0%, var(--bg) 100%);
      border-bottom: 1px solid var(--border);
    }
    .hero-header h1 {
      font-size: 3rem;
      margin: 0 0 1rem;
      background: linear-gradient(135deg, var(--accent), var(--accent-hover));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-header p {
      font-size: 1.25rem;
      color: var(--fg-muted);
      max-width: 600px;
      margin: 0 auto 2rem;
    }
    .hero-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .hero-meta {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      flex-wrap: wrap;
      color: var(--fg-muted);
      font-size: 0.9rem;
    }
    .hero-meta span { display: flex; align-items: center; gap: 0.35rem; }
  </style>

  <div class="hero-actions">
    <a href="/installation" class="btn btn-primary">Get Started</a>
    <a href="https://github.com/Naaach/nprogress-next" target="_blank" rel="noopener" class="btn">GitHub</a>
    <a href="https://www.npmjs.com/package/nprogress-next" target="_blank" rel="noopener" class="btn">npm</a>
  </div>

  <div class="hero-meta">
    <span>📦 <strong>2.9 KB</strong> gzipped</span>
    <span>⚡ Zero dependencies</span>
    <span>🎯 TypeScript</span>
    <span>♿ Accessible</span>
    <span>🌙 Reduced motion</span>
    <span>🔧 SSR-safe</span>
  </div>

  <h2>Why nprogress-next?</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin: 2rem 0;">
    <article class="card">
      <h3>🔄 Same API</h3>
      <p><code>start</code> / <code>done</code> / <code>set</code> / <code>inc</code> / <code>configure</code> / <code>remove</code> + <code>.status</code> — drop-in replacement for NProgress 0.2.0.</p>
    </article>
    <article class="card">
      <h3>📦 Zero Dependencies</h3>
      <p>Core stays tiny (<strong>2.9 KB gzipped</strong>). No peer dependencies, no runtime overhead.</p>
    </article>
    <article class="card">
      <h3>🎯 TypeScript First</h3>
      <p>Written in TS, shipped with first-class types. Full IntelliSense for all APIs.</p>
    </article>
    <article class="card">
      <h3>⚡ ESM + CJS + UMD</h3>
      <p>Works everywhere — bundlers, Node, browsers, CDN. SSR-safe for Next.js, Nuxt, Astro.</p>
    </article>
    <article class="card">
      <h3>🔧 Multi-Framework</h3>
      <p>Core engine + official adapters: <strong>React</strong> (<code>{pb}</code>, <code>useProgress()</code>) and <strong>Vue</strong> (<code>{pb}</code>, <code>useProgress()</code>, plugin).</p>
    </article>
    <article class="card">
      <h3>♿ Accessible</h3>
      <p><code>role="progressbar"</code>, live <code>aria-valuenow</code>, respects <code>prefers-reduced-motion</code>.</p>
    </article>
  </div>

  <h2>Quick Example</h2>
  <div class="code-block">
    <div class="code-header"><span>Quick start</span></div>
    <pre><code>import NProgress from 'nprogress-next'

NProgress.start()
// ... async work ...
NProgress.done()</code></pre>
  </div>

  <h2>Ecosystem</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Package</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>nprogress-next</code></td><td>Core engine (framework-agnostic)</td></tr>
        <tr><td><code>nprogress-next-react</code></td><td>React adapter ({pb}, <code>useProgress()</code>)</td></tr>
        <tr><td><code>nprogress-next-vue</code></td><td>Vue adapter ({pb}, <code>useProgress()</code>, plugin)</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Documentation</h2>
  <ul style="list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
    {sorted.map(entry => (
      <li>
        <article class="card">
          <h3 style="margin: 0 0 0.5rem;"><a href={`/${entry.slug}`}>{entry.data.title}</a></h3>
          <p style="margin: 0; color: var(--fg-muted); font-size: 0.9rem;">{entry.data.description}</p>
        </article>
      </li>
    ))}
  </ul>
</Layout>