---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entries = await getCollection('docs');
const sorted = entries.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const pb = '<ProgressBar />';
---

<Layout title="nprogress-next" description="A minimalist, dependency-free, multi-framework progress bar for the top of the page.">
  <section class="hero">
    <h1>Progress bars, modernized.</h1>
    <p class="lede">
      A drop-in replacement for NProgress — same API, now TypeScript-first,
      dependency-free and multi-framework. React and Vue adapters included.
    </p>
    <div class="hero-actions">
      <a href="/installation" class="btn btn-primary">Get started</a>
      <a href="https://github.com/Naaach/nprogress-next" target="_blank" rel="noopener" class="btn">GitHub</a>
      <a href="https://www.npmjs.com/package/nprogress-next" target="_blank" rel="noopener" class="btn">npm</a>
    </div>
    <div class="hero-meta">
      <span>📦 <strong>2.9 KB</strong> gzipped</span>
      <span>⚡ Zero dependencies</span>
      <span>🎯 TypeScript</span>
      <span>♿ Accessible</span>
      <span>🌙 Reduced motion</span>
      <span>🔧 SSR-safe</span>
    </div>
  </section>

  <section class="home-section">
    <h2>Quick start</h2>
    <div class="code-block">
      <div class="code-header">
        <span><span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>terminal</span>
        <button class="copy-button" type="button">Copy</button>
      </div>
      <pre><code>npm install nprogress-next</code></pre>
    </div>
    <div class="code-block">
      <div class="code-header">
        <span>app.js</span>
        <button class="copy-button" type="button">Copy</button>
      </div>
      <pre><code>import NProgress from 'nprogress-next'

NProgress.start()
// ...some async work...
NProgress.done()</code></pre>
    </div>
  </section>

  <section class="home-section" id="demo">
    <h2>Live demo</h2>
    <p>
      This page is running the real <code>nprogress-next</code> core right now — the bar at the
      very top is the component itself, not a screenshot. It also runs automatically when you
      click any internal link in the docs.
    </p>
    <div class="demo-controls">
      <button class="btn btn-primary" type="button" data-np-action="start">start()</button>
      <button class="btn" type="button" data-np-action="set">set(0.4)</button>
      <button class="btn" type="button" data-np-action="inc">inc()</button>
      <button class="btn" type="button" data-np-action="done">done()</button>
    </div>
    <p class="demo-status">
      <span>status</span>
      <code data-np-status>idle</code>
    </p>
  </section>

  <script>
    import NProgress from 'nprogress-next';

    const status = document.querySelector('[data-np-status]');
    const renderStatus = (value: number | null) => {
      if (status) status.textContent = value === null ? 'idle' : `${Math.round(value * 100)}%`;
    };
    renderStatus(NProgress.status);
    NProgress.subscribe(renderStatus);

    document.querySelectorAll<HTMLElement>('[data-np-action]').forEach((button) => {
      button.addEventListener('click', () => {
        switch (button.dataset.npAction) {
          case 'start':
            NProgress.start();
            break;
          case 'set':
            NProgress.set(0.4);
            break;
          case 'inc':
            NProgress.inc();
            break;
          case 'done':
            NProgress.done();
            break;
        }
      });
    });
  </script>

  <section class="home-section">
    <h2>Why nprogress-next?</h2>
    <div class="grid">
      <article class="card">
        <h3>🔄 Same API</h3>
        <p><code>start</code>, <code>done</code>, <code>set</code>, <code>inc</code>, <code>configure</code>, <code>remove</code>. Drop-in for NProgress 0.2.0.</p>
      </article>
      <article class="card">
        <h3>📦 Zero dependencies</h3>
        <p>Core is <strong>2.9 KB gzipped</strong>, budget-gated in CI. Nothing else to install.</p>
      </article>
      <article class="card">
        <h3>🎯 TypeScript</h3>
        <p>Written in TypeScript and shipped with first-class types.</p>
      </article>
      <article class="card">
        <h3>⚡ ESM + CJS + UMD</h3>
        <p>Bundlers, Node, browsers and CDN. SSR-safe on Next.js, Nuxt and Astro.</p>
      </article>
      <article class="card">
        <h3>🔧 Multi-framework</h3>
        <p>React and Vue adapters: <code>{pb}</code> and <code>useProgress()</code>.</p>
      </article>
      <article class="card">
        <h3>♿ Accessible</h3>
        <p><code>role="progressbar"</code>, live <code>aria-valuenow</code> and <code>prefers-reduced-motion</code>.</p>
      </article>
    </div>
  </section>

  <section class="home-section">
    <h2>Packages</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Package</th><th>Description</th></tr>
        </thead>
        <tbody>
          <tr><td><code>nprogress-next</code></td><td>Core engine, framework-agnostic</td></tr>
          <tr><td><code>nprogress-next-react</code></td><td>React adapter ({pb}, <code>useProgress()</code>)</td></tr>
          <tr><td><code>nprogress-next-vue</code></td><td>Vue adapter ({pb}, <code>useProgress()</code>, plugin)</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="home-section">
    <h2>Documentation</h2>
    <div class="grid">
      {sorted.map((entry) => (
        <article class="card">
          <h3><a href={`/${entry.slug}`}>{entry.data.title}</a></h3>
          <p>{entry.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>