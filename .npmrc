auto-install-peers=true
strict-peer-dependencies=false
link-workspace-packages=true

# Note: npm auth is intentionally NOT declared here. pnpm 12 does not expand
# ${ENV} placeholders in repository-controlled registry credentials, so a
# `//registry.npmjs.org/:_authToken=${NPM_TOKEN}` line is ignored (with a
# warning). In CI the token is injected outside the repo by actions/setup-node
# (registry-url) through NODE_AUTH_TOKEN. See .github/workflows/release.yml.
