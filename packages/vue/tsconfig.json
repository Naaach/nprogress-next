{
  // Browser-facing program: library sources plus their tests.
  //
  // `tsup.config.ts` is deliberately *not* part of this program — it is a
  // Node-side build script, so pulling it in here would drag `@types/node` into a
  // DOM-only program. It is type-checked by the root `tsconfig.json`.
  //
  // `node` is in `types` for the *test* half only: the suite reads
  // `src/styles.css` off disk to assert on the reduced-motion fallback, because
  // the root Vitest config runs with `css: false` (any CSS import — bare,
  // `?inline` or `?raw` — resolves to an empty string), and an injected
  // `readFileSync` type in `test/` is a far smaller hole than a
  // `declare module "node:fs"` shim.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "test"]
}