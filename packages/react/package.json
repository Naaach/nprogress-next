{
  "name": "nprogress-next-react",
  "version": "0.1.0",
  "description": "React components and hooks for nprogress-next — a controlled, inline-styled <ProgressBar /> and a useProgress() hook.",
  "keywords": [
    "nprogress",
    "progress",
    "progressbar",
    "progress-bar",
    "loading",
    "loading-bar",
    "topbar",
    "react",
    "react19",
    "hooks",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "author": "nprogress-next contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naaach/nprogress-next.git",
    "directory": "packages/react"
  },
  "homepage": "https://nprogress-next.nachodiaz.es",
  "bugs": {
    "url": "https://github.com/Naaach/nprogress-next/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "dependencies": {
    "nprogress-next": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}