{
  "name": "nprogress-next-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for nprogress-next — a modern, dependency-free, multi-framework drop-in replacement for NProgress.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:docs": "pnpm --filter nprogress-next-docs build",
    "clean": "pnpm -r --if-present clean",
    "size": "node scripts/size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "dev:docs": "pnpm --filter nprogress-next-docs dev",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "vue": "^3.5.44"
  }
}